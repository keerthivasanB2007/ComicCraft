# ===================================================
# ComicCraft Environment Configuration
# ===================================================

# Google Gemini API Key (Required for Flash & Pro stages)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Identifiers (Google GenAI)
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Stable Diffusion Model ID (Hugging Face)
SD_MODEL_ID=segmind/tiny-sd
SD_STEPS=10
